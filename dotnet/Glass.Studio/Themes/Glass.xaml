<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Палитра (кисти) лежит в Palette.Light.xaml / Palette.Dark.xaml и подменяется при смене темы: здесь и в окнах на неё
         ссылаются через {DynamicResource}. -->

    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ===================== Панели ===================== -->
    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PanelHeader" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="5,5,0,0" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MonoMutedText" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Margin" Value="24" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ===================== Значки панели инструментов ===================== -->
    <Geometry x:Key="IconPlay">M 4,2.5 L 13,8 L 4,13.5 Z</Geometry>
    <Geometry x:Key="IconStop">M 3.5,3.5 L 12.5,3.5 L 12.5,12.5 L 3.5,12.5 Z</Geometry>
    <Geometry x:Key="IconStepInto">M 8,1.5 L 8,9.5 M 4.5,6.5 L 8,10 L 11.5,6.5 M 6.8,13.6 A 1.2,1.2 0 1 1 9.2,13.6 A 1.2,1.2 0 1 1 6.8,13.6</Geometry>
    <Geometry x:Key="IconStepOver">M 2.5,9 C 2.5,2.5 13.5,2.5 13.5,9 M 11.3,7.3 L 13.5,9.5 L 15.5,7.3 M 6.8,13.6 A 1.2,1.2 0 1 1 9.2,13.6 A 1.2,1.2 0 1 1 6.8,13.6</Geometry>
    <Geometry x:Key="IconStepOut">M 8,10 L 8,2 M 4.5,5.5 L 8,2 L 11.5,5.5 M 6.8,14.4 A 1.2,1.2 0 1 1 9.2,14.4 A 1.2,1.2 0 1 1 6.8,14.4</Geometry>
    <Geometry x:Key="IconTrash">M 3.5,4.5 L 12.5,4.5 M 6,4.5 L 6,2.5 L 10,2.5 L 10,4.5 M 4.5,4.5 L 5.2,13.5 L 10.8,13.5 L 11.5,4.5 M 7,7 L 7,11 M 9,7 L 9,11</Geometry>
    <Geometry x:Key="IconCourse">M 2,3.5 C 4.5,2.6 6.6,2.8 8,4 C 9.4,2.8 11.5,2.6 14,3.5 L 14,12.5 C 11.5,11.6 9.4,11.8 8,13 C 6.6,11.8 4.5,11.6 2,12.5 Z M 8,4 L 8,13</Geometry>
    <EllipseGeometry x:Key="IconBreakpoint" Center="8,8" RadiusX="5" RadiusY="5" />

    <Style x:Key="ToolIcon" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <!-- IsEnabled наследуется от кнопки: недоступная команда — блёклый значок -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Прочее ===================== -->
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ChangedSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BannerBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="StateDot" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource StateIdleBrush}" />
    </Style>

    <!-- ===================== Карточка элемента кода (правая кнопка мыши, F1) ===================== -->
    <!-- Внешний отступ оставляет место для тени: окно Popup прозрачное и обрезает всё, что за его границей. -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="6,6,14,14" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.28" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardKindChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardKindText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="CardDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="CardExample" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CanvasBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <Style x:Key="CardOrigin" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="CardActions" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Padding" Value="0,8,0,0" />
    </Style>

    <!-- Плоская кнопка-действие: без рамки, при наведении и фокусе подсвечивается. -->
    <Style x:Key="CardAction" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
