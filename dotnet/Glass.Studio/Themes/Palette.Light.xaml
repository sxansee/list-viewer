<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Светлая палитра (вид по умолчанию). Набор ключей одинаков в Palette.Light.xaml и Palette.Dark.xaml — это проверяет тест, а он же
         проверяет контраст текста в тёмной палитре. Окна ссылаются на кисти через {DynamicResource}, поэтому смена
         палитры на лету перекрашивает всё сразу. -->

    <!-- ===================== Основа и схема кучи ===================== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F2F4F8" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#E9EEF5" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#D3DAE5" />
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FAFBFD" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7788" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4EDFE" />
    <SolidColorBrush x:Key="RefBrush" Color="#6D3FC4" />
    <SolidColorBrush x:Key="GarbageBrush" Color="#D64545" />
    <SolidColorBrush x:Key="GarbageSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="GarbageHeaderBrush" Color="#F8D5D5" />
    <SolidColorBrush x:Key="NewBrush" Color="#15803D" />
    <SolidColorBrush x:Key="NewSoftBrush" Color="#E3F6EA" />
    <SolidColorBrush x:Key="ChangedBrush" Color="#B45309" />
    <SolidColorBrush x:Key="ChangedSoftBrush" Color="#FFF1D6" />
    <SolidColorBrush x:Key="ObjectHeaderBrush" Color="#E3ECFB" />
    <SolidColorBrush x:Key="ArrayHeaderBrush" Color="#DDF3E5" />
    <SolidColorBrush x:Key="NodeBorderBrush" Color="#9AA9BE" />
    <SolidColorBrush x:Key="EdgeBrush" Color="#7487A3" />
    <SolidColorBrush x:Key="SlotIntBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="SlotDoubleBrush" Color="#0D9488" />
    <SolidColorBrush x:Key="SlotBoolBrush" Color="#D97706" />
    <SolidColorBrush x:Key="SlotRefBrush" Color="#8B5CF6" />

    <!-- ===================== Бывшие «зашитые» цвета окон и стилей ===================== -->
    <SolidColorBrush x:Key="TitleTextBrush" Color="#3A4656" />
    <SolidColorBrush x:Key="BannerBorderBrush" Color="#F1CF8E" />
    <SolidColorBrush x:Key="StateIdleBrush" Color="#9AA7B8" />
    <SolidColorBrush x:Key="StateRunningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="StatePausedBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="StateDoneBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="IconPlayBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="IconStopBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="IconBreakpointBrush" Color="#E03131" />
    <SolidColorBrush x:Key="IconCleanBrush" Color="#6D3FC4" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF2F9" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F6F8FB" />
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#E5E9F0" />
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="CodeBorderBrush" Color="#111827" />
    <SolidColorBrush x:Key="CodeTextBrush" Color="#E5E7EB" />

    <!-- ===================== Состояния элементов управления (нужны тёмным шаблонам Controls.Dark.xaml) ===================== -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#E4EAF3" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#D3DAE5" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#B8C2D2" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#A3ACB9" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#CFE0FB" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#EEF1F6" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3CCD9" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A5B0C1" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#D3DAE5" />
    <SolidColorBrush x:Key="TabSelectedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#F8FAFC" />

    <!-- ===================== Редактор кода, подсветка строк, поле точек останова, инлайн-код в подсказках ===================== -->
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="EditorTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="EditorLineNumberBrush" Color="#8A94A6" />
    <SolidColorBrush x:Key="EditorGutterBrush" Color="#F4F6FA" />
    <SolidColorBrush x:Key="EditorSelectionBrush" Color="#CFE0FB" />
    <SolidColorBrush x:Key="ExecutionFillBrush" Color="#FFF3B0" />
    <SolidColorBrush x:Key="ExecutionStripeBrush" Color="#F2C200" />
    <SolidColorBrush x:Key="CallerFillBrush" Color="#D9F5DF" />
    <SolidColorBrush x:Key="CallerStripeBrush" Color="#2FA84F" />
    <SolidColorBrush x:Key="ErrorFillBrush" Color="#FFD9D6" />
    <SolidColorBrush x:Key="ErrorStripeBrush" Color="#D64545" />
    <SolidColorBrush x:Key="ProblemFillBrush" Color="#FFEAE7" />
    <SolidColorBrush x:Key="BreakpointDotBrush" Color="#E03131" />
    <SolidColorBrush x:Key="BreakpointHoverBrush" Color="#55E03131" />
    <SolidColorBrush x:Key="InlineCodeBackgroundBrush" Color="#ECF0F7" />
    <SolidColorBrush x:Key="InlineCodeTextBrush" Color="#9D1B56" />

</ResourceDictionary>
