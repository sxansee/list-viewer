<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Тёмная палитра. Набор ключей одинаков в Palette.Light.xaml и Palette.Dark.xaml — это проверяет тест, а он же
         проверяет контраст текста в тёмной палитре. Окна ссылаются на кисти через {DynamicResource}, поэтому смена
         палитры на лету перекрашивает всё сразу. -->

    <!-- ===================== Основа и схема кучи ===================== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#12151A" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1A1E25" />
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#222833" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#333C4A" />
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#151920" />
    <SolidColorBrush x:Key="TextBrush" Color="#E4E8EF" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA6B8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1B2B47" />
    <SolidColorBrush x:Key="RefBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="GarbageBrush" Color="#F87171" />
    <SolidColorBrush x:Key="GarbageSoftBrush" Color="#3A2025" />
    <SolidColorBrush x:Key="GarbageHeaderBrush" Color="#4D272D" />
    <SolidColorBrush x:Key="NewBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="NewSoftBrush" Color="#15301F" />
    <SolidColorBrush x:Key="ChangedBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="ChangedSoftBrush" Color="#3A2F14" />
    <SolidColorBrush x:Key="ObjectHeaderBrush" Color="#1F2E4A" />
    <SolidColorBrush x:Key="ArrayHeaderBrush" Color="#1C3526" />
    <SolidColorBrush x:Key="NodeBorderBrush" Color="#566277" />
    <SolidColorBrush x:Key="EdgeBrush" Color="#8798B2" />
    <SolidColorBrush x:Key="SlotIntBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="SlotDoubleBrush" Color="#0D9488" />
    <SolidColorBrush x:Key="SlotBoolBrush" Color="#D97706" />
    <SolidColorBrush x:Key="SlotRefBrush" Color="#8B5CF6" />

    <!-- ===================== Бывшие «зашитые» цвета окон и стилей ===================== -->
    <SolidColorBrush x:Key="TitleTextBrush" Color="#C5CFDD" />
    <SolidColorBrush x:Key="BannerBorderBrush" Color="#7A5B1C" />
    <SolidColorBrush x:Key="StateIdleBrush" Color="#5E6B80" />
    <SolidColorBrush x:Key="StateRunningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="StatePausedBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="StateDoneBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="IconPlayBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="IconStopBrush" Color="#F87171" />
    <SolidColorBrush x:Key="IconBreakpointBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="IconCleanBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="HoverBrush" Color="#262E3B" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#181C23" />
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#2B3443" />
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#0E1217" />
    <SolidColorBrush x:Key="CodeBorderBrush" Color="#2B3441" />
    <SolidColorBrush x:Key="CodeTextBrush" Color="#E4E8EF" />

    <!-- ===================== Состояния элементов управления (нужны тёмным шаблонам Controls.Dark.xaml) ===================== -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#262D39" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#323B4A" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#3B4659" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#465165" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6B7686" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#25416E" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#F2F6FF" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#171B21" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A5568" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6B7A93" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#1F242D" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#333C4A" />
    <SolidColorBrush x:Key="TabSelectedBrush" Color="#1A1E25" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#2B3443" />

    <!-- ===================== Редактор кода, подсветка строк, поле точек останова, инлайн-код в подсказках ===================== -->
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#161A20" />
    <SolidColorBrush x:Key="EditorTextBrush" Color="#D8DEE9" />
    <SolidColorBrush x:Key="EditorLineNumberBrush" Color="#7C889B" />
    <SolidColorBrush x:Key="EditorGutterBrush" Color="#1B2027" />
    <SolidColorBrush x:Key="EditorSelectionBrush" Color="#264F78" />
    <SolidColorBrush x:Key="ExecutionFillBrush" Color="#3A3414" />
    <SolidColorBrush x:Key="ExecutionStripeBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="CallerFillBrush" Color="#17331F" />
    <SolidColorBrush x:Key="CallerStripeBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="ErrorFillBrush" Color="#43211F" />
    <SolidColorBrush x:Key="ErrorStripeBrush" Color="#F87171" />
    <SolidColorBrush x:Key="ProblemFillBrush" Color="#301C1C" />
    <SolidColorBrush x:Key="BreakpointDotBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="BreakpointHoverBrush" Color="#55FF6B6B" />
    <SolidColorBrush x:Key="InlineCodeBackgroundBrush" Color="#262E3B" />
    <SolidColorBrush x:Key="InlineCodeTextBrush" Color="#F28DB8" />

</ResourceDictionary>
