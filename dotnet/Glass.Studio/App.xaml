<Application x:Class="Glass.Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Glass.xaml" />
                <!-- Палитра по умолчанию — светлая; при смене темы ThemeManager подменяет этот словарь (и добавляет Controls.Dark.xaml). -->
                <ResourceDictionary Source="Themes/Palette.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
