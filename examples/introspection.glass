mold Animal {
    let name: string
    let age: int

    Animal(n: string, a: int) {
        name = n
        age = a
    }

    virtual fn speak() -> string {
        return "..."
    }
}

mold Dog : Animal {
    let breed: string

    Dog(n: string, a: int, b: string) {
        super(n, a)
        breed = b
    }

    override fn speak() -> string {
        return "Woof"
    }
}

fn main() {
    let d = Dog("Rex", 3, "Labrador")

    // ~heap — снимок всей кучи целиком на этот момент: пока в ней один
    // объект, d
    print(~heap)

    // ~address — адрес объекта в куче, как int
    print(d~address)

    // ~layout — раскладка полей: унаследованные (name, age — от Animal)
    // первыми, свои (breed) дальше, ровно тот же порядок, что использует
    // сама VM для доступа к полям
    print(d~layout)

    // ~vtable — какая реализация speak() реально вызовется: видно, что
    // это Dog.speak (override), а не Animal.speak
    print(d~vtable)

    // Результаты ~layout и ~vtable и даже прошлый снимок ~heap — тоже
    // объекты (LayoutInfo, VTableInfo, HeapSnapshot и массивы внутри них)
    // и лежат в той же куче. Поэтому в новом снимке не один объект, а
    // несколько: интроспекция сама оставляет след
    print(~heap)

    // ~gc — запустить сборку мусора вручную, не дожидаясь порога
    ~gc

    // Ни на один из них никто не ссылается — они недостижимы и собраны;
    // в снимке снова только d
    print(~heap)
}
