<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light. The real look comes from Compose (Theme.kt); this theme only paints the window
         while the app starts, so there is no white flash in dark mode. -->
    <style name="Theme.List" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/list_background</item>
        <item name="android:colorBackground">@color/list_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
